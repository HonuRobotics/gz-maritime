<?xml version="1.0"?>
<!--
  Visualize the tutorial USV description in RViz: robot_state_publisher on the
  expanded xacro, joint_state_publisher_gui (sliders to spin the propellers)
  and RViz with the packaged config. Pure ROS: no Gazebo.

      ros2 launch tutorial_usv_description display.launch.xml
-->
<launch>
  <arg name="gui" default="true"
       description="Start joint_state_publisher_gui to drive the propeller joints."/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher"
        name="robot_state_publisher">
    <!-- type="str": keep launch from running yaml type inference over the URDF. -->
    <param name="robot_description"
           value="$(command 'xacro $(find-pkg-share tutorial_usv_description)/urdf/tutorial_usv.urdf.xacro')"
           type="str"/>
  </node>

  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"
        name="joint_state_publisher_gui" if="$(var gui)"/>

  <node pkg="rviz2" exec="rviz2" name="rviz2"
        args="-d $(find-pkg-share tutorial_usv_description)/rviz/tutorial_usv.rviz"/>
</launch>
