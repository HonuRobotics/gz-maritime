<?xml version="1.0"?>
<!--
  A current that grows with depth, from a table: none at z = 2, 1 m/s along
  +x at z = -2, so 0.5 m/s at z = 0, where both link origins are.
  "at_point" writes its hydrodynamics one metre below its origin and feels
  the water there, 0.75 m/s. "at_origin" names no point and feels the water
  at its link origin, 0.5 m/s, not at its centre of mass half a metre below,
  0.625 m/s. "bad_tag" is the same body with a point that is not three
  numbers, which is reported and ignored. No gravity and no buoyancy; the
  large inertia keeps the bodies from turning during the test.
-->
<sdf version="1.9">
  <world name="current_shear">
    <gravity>0 0 0</gravity>
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-environment-preload-system"
            name="gz::sim::systems::EnvironmentPreload">
      <data>current_shear.csv</data>
      <dimensions>
        <time>timestamp</time>
        <space>
          <x>x</x>
          <y>y</y>
          <z>z</z>
        </space>
      </dimensions>
    </plugin>
    <model name="at_point">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>1000</ixx><iyy>1000</iyy><izz>1000</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
      <plugin filename="gz-maritime-hydrodynamics-system"
              name="gz::sim::maritime::Hydrodynamics">
        <link_name>link</link_name>
        <center_of_pressure>0 0 -1</center_of_pressure>
        <lookup_current_x>current_x</lookup_current_x>
        <lookup_current_y>current_y</lookup_current_y>
        <lookup_current_z>current_z</lookup_current_z>
        <xU>-1</xU>
      </plugin>
    </model>
    <model name="at_origin">
      <pose>0 5 0 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 -0.5 0 0 0</pose>
          <mass>10</mass>
          <inertia>
            <ixx>1000</ixx><iyy>1000</iyy><izz>1000</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
      <plugin filename="gz-maritime-hydrodynamics-system"
              name="gz::sim::maritime::Hydrodynamics">
        <link_name>link</link_name>
        <lookup_current_x>current_x</lookup_current_x>
        <lookup_current_y>current_y</lookup_current_y>
        <lookup_current_z>current_z</lookup_current_z>
        <xU>-1</xU>
      </plugin>
    </model>
    <model name="bad_tag">
      <pose>0 10 0 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 -0.5 0 0 0</pose>
          <mass>10</mass>
          <inertia>
            <ixx>1000</ixx><iyy>1000</iyy><izz>1000</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
      <plugin filename="gz-maritime-hydrodynamics-system"
              name="gz::sim::maritime::Hydrodynamics">
        <link_name>link</link_name>
        <center_of_pressure>0 0 -1 0</center_of_pressure>
        <lookup_current_x>current_x</lookup_current_x>
        <lookup_current_y>current_y</lookup_current_y>
        <lookup_current_z>current_z</lookup_current_z>
        <xU>-1</xU>
      </plugin>
    </model>
  </world>
</sdf>
