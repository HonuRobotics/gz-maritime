<?xml version="1.0"?>
<!--
  Tilted bodies whose added mass is the physics engine's
  (<fluid_added_mass>), in a uniform current, with no coefficient in the
  plugin: all it applies is the Coriolis correction for that added mass. The
  matrix belongs to the link, so the correction must not depend on the
  application point: "at_point" and "at_origin" must move alike.
  "no_plugin" has the same added mass and no plugin, to show the correction
  is at work.
-->
<sdf version="1.11">
  <world name="application_point_fluid_added_mass">
    <gravity>1.0 0.5 -2.0</gravity>
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <model name="at_point">
      <pose>0 0 0 0.3 -0.2 0.5</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>10</mass>
          <inertia>
            <ixx>0.15</ixx><iyy>0.2</iyy><izz>0.25</izz>
            <ixy>0.01</ixy><ixz>-0.02</ixz><iyz>0.005</iyz>
          </inertia>
          <fluid_added_mass>
            <xx>2</xx><yy>8</yy><zz>5</zz>
            <pp>0.05</pp><qq>0.05</qq><rr>0.05</rr>
          </fluid_added_mass>
        </inertial>
      </link>
      <plugin filename="gz-maritime-hydrodynamics-system"
              name="gz::sim::maritime::Hydrodynamics">
        <link_name>link</link_name>
        <application_point>0 0 -0.5</application_point>
        <default_current>0.3 0.2 0</default_current>
      </plugin>
    </model>
    <model name="at_origin">
      <pose>0 10 0 0.3 -0.2 0.5</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>10</mass>
          <inertia>
            <ixx>0.15</ixx><iyy>0.2</iyy><izz>0.25</izz>
            <ixy>0.01</ixy><ixz>-0.02</ixz><iyz>0.005</iyz>
          </inertia>
          <fluid_added_mass>
            <xx>2</xx><yy>8</yy><zz>5</zz>
            <pp>0.05</pp><qq>0.05</qq><rr>0.05</rr>
          </fluid_added_mass>
        </inertial>
      </link>
      <plugin filename="gz-maritime-hydrodynamics-system"
              name="gz::sim::maritime::Hydrodynamics">
        <link_name>link</link_name>
        <default_current>0.3 0.2 0</default_current>
      </plugin>
    </model>
    <model name="no_plugin">
      <pose>0 20 0 0.3 -0.2 0.5</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>10</mass>
          <inertia>
            <ixx>0.15</ixx><iyy>0.2</iyy><izz>0.25</izz>
            <ixy>0.01</ixy><ixz>-0.02</ixz><iyz>0.005</iyz>
          </inertia>
          <fluid_added_mass>
            <xx>2</xx><yy>8</yy><zz>5</zz>
            <pp>0.05</pp><qq>0.05</qq><rr>0.05</rr>
          </fluid_added_mass>
        </inertial>
      </link>
    </model>
  </world>
</sdf>
