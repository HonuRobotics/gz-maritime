<?xml version="1.0"?>
<!--
  Two bodies with the same added mass, 1 kg in surge and 6 kg in sway, one
  in the plugin's coefficients and one in the physics engine's
  <fluid_added_mass>. No damping, still water, and a "gravity" along x and y
  that pushes both diagonally from rest.
-->
<sdf version="1.11">
  <world name="added_mass">
    <gravity>1.0 0.5 0</gravity>
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <model name="plugin">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>0.15</ixx><iyy>0.2</iyy><izz>0.25</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
      </link>
      <plugin filename="gz-maritime-hydrodynamics-system"
              name="gz::sim::maritime::Hydrodynamics">
        <link_name>link</link_name>
        <xDotU>-1</xDotU><yDotV>-6</yDotV><zDotW>-3</zDotW>
        <kDotP>-0.01</kDotP><mDotQ>-0.02</mDotQ><nDotR>-0.02</nDotR>
      </plugin>
    </model>
    <model name="native">
      <pose>0 5 0 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>10</mass>
          <inertia>
            <ixx>0.15</ixx><iyy>0.2</iyy><izz>0.25</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
          <fluid_added_mass>
            <xx>1</xx><yy>6</yy><zz>3</zz>
            <pp>0.01</pp><qq>0.02</qq><rr>0.02</rr>
          </fluid_added_mass>
        </inertial>
      </link>
    </model>
  </world>
</sdf>
