<?xml version="1.0"?>
<!-- No acoustics panel at start: MenuLoader adds one later, as the plugin
     menu does, after the GUI has its first state. -->
<plugin filename="ScenarioPanel" name="Scenarios">
  <gz-gui>
    <title>Scenarios</title>
  </gz-gui>
</plugin>
<plugin filename="MenuLoader" name="Menu loader">
  <add>AcousticsPanel</add>
  <after>5</after>
</plugin>
