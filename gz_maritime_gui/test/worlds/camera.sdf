<?xml version="1.0"?>
<!--
  A camera 10 m above an empty, grey scene, looking straight down, for the
  test that the panels' markers stay out of cameras. Rendered headless.
-->
<sdf version="1.9">
  <world name="marker_test">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.5 0.5 0.5</ambient><background>0.2 0.2 0.2</background></scene>
    <light type="directional" name="sun">
      <direction>-0.3 0.2 -1</direction>
      <diffuse>1 1 1 1</diffuse>
    </light>
    <model name="camera">
      <static>true</static>
      <pose>0 0 10 0 1.5707963 0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <topic>/marker_test/image</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>160</width><height>120</height></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
