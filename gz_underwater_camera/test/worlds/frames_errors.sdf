<?xml version="1.0"?>
<!--
  The plugin where it does not belong, in a plain camera: disabled. And in
  an rgbd_camera with parameters that make no sense: each falls back to its
  default, and the camera still works.
-->
<sdf version="1.9">
  <world name="frames_errors">
    <physics name="p" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-maritime-water-optics-system"
            name="gz::sim::maritime::WaterOptics">
      <jerlov>3C</jerlov>
    </plugin>
    <model name="rig">
      <static>true</static>
      <pose>0 0 -2 0 0 0</pose>
      <link name="link">
      <sensor name="plain" type="camera">
        <topic>ferr/plain</topic>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>8</width><height>6</height></image>
        </camera>
        <plugin filename="gz-maritime-underwater-camera-system"
                name="gz::sim::maritime::UnderwaterCamera"/>
      </sensor>
      <sensor name="odd" type="rgbd_camera">
        <pose>0 0.0 0 0 0 0</pose>
        <topic>ferr/odd</topic>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>8</width><height>6</height></image>
          <clip><near>0.1</near><far>60</far></clip>
        </camera>
        <plugin filename="gz-maritime-underwater-camera-system"
                name="gz::sim::maritime::UnderwaterCamera">
          <exposure>2abc</exposure>
          <white_balance>magic</white_balance>
          <shot_noise>-1</shot_noise>
          <forward_scatter>-0.1</forward_scatter>
          <port>fisheye</port>
          <water_index>0.5</water_index>
        </plugin>
      </sensor>
      </link>
    </model>
  </world>
</sdf>
