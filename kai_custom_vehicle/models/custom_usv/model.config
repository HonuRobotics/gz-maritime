<?xml version="1.0"?>
<model>
  <name>custom_usv</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>

  <author>
    <name>Alejandro Hernandez Cordero</name>
    <email>acordero@honurobotics.com</email>
  </author>

  <description>
    Simulation model of the gz-maritime custom USV, a 1 m twin-hull
    catamaran: its URDF merged with the displacement volume that floats it,
    two thrusters, hydrodynamics and sensors. The default instance, named
    custom_usv; kai_bringup's spawn_vehicle.launch.xml renders any other.
    Spawn it into a world running gz_buoyancy, or include it as
    model://custom_usv.
  </description>
</model>
