<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gz_water_optics</name>
  <version>0.1.0</version>
  <description>The optics of a world's water for Gazebo Sim, as a recipe any system can query: how the water attenuates and scatters light per colour channel (from a Jerlov water type, a visibility, or explicit coefficients), the veil it adds, and how the daylight fades with depth below the wave surface. A world system owns the recipe, takes changes on a topic and publishes it as ground truth; a sampler answers at any point.</description>
  <maintainer email="acordero@honurobotics.com">Alejandro Hernandez Cordero</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_math_vendor</depend>
  <depend>gz_common_vendor</depend>
  <!-- The set topic and the ground truth. -->
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>
  <!-- The water level under a wave field: depth below the local surface. -->
  <depend>gz_waves</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- The depth test floats on one long Gerstner wave. -->
  <test_depend>gz_waves_provider_gerstner</test_depend>
  <test_depend>python3-matplotlib</test_depend>
  <test_depend>python3-numpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
