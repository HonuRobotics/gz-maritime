<?xml version="1.0"?>
<!--
  Shipwreck, modeled on the Monohansett. Generated by build_shipwreck.py; edit
  the script, not this file.

  The model frame is the wreck's datum: on the seabed plane, on the keel
  centerline, at the boiler's forward face, +X toward the bow. Place the model
  with z at the seabed; a negative offset buries it. Every part's .glb shares
  the model frame, so each visual carries only the profile's glTF-to-Gazebo
  rotation. Acoustic values are illustrative (spec, Acoustic properties).
  The meshes are the exact ground truth geometry; named features are in
  ground_truth/features.yaml, in this same frame.
-->
<sdf version="1.12" xmlns:gz="http://gazebosim.org/schema">
  <model name="shipwreck">
    <static>true</static>
    <link name="wreck">
      <visual name="hull">
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>model://shipwreck/meshes/hull_visual.glb</uri></mesh></geometry>
        <gz:acoustic_lambert>-25</gz:acoustic_lambert>
      </visual>
      <visual name="mast">
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>model://shipwreck/meshes/mast_visual.glb</uri></mesh></geometry>
        <gz:acoustic_lambert>-25</gz:acoustic_lambert>
      </visual>
      <visual name="boiler">
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>model://shipwreck/meshes/boiler_visual.glb</uri></mesh></geometry>
        <gz:acoustic_lambert>-15</gz:acoustic_lambert>
        <gz:acoustic_specular>-5</gz:acoustic_specular>
        <gz:acoustic_specular_width>0.1</gz:acoustic_specular_width>
      </visual>
      <visual name="engine">
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>model://shipwreck/meshes/engine_visual.glb</uri></mesh></geometry>
        <gz:acoustic_lambert>-15</gz:acoustic_lambert>
        <gz:acoustic_specular>-5</gz:acoustic_specular>
        <gz:acoustic_specular_width>0.1</gz:acoustic_specular_width>
      </visual>
      <visual name="debris">
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>model://shipwreck/meshes/debris_visual.glb</uri></mesh></geometry>
        <gz:acoustic_lambert>-15</gz:acoustic_lambert>
        <gz:acoustic_specular>-5</gz:acoustic_specular>
        <gz:acoustic_specular_width>0.1</gz:acoustic_specular_width>
      </visual>
      <visual name="propeller">
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>model://shipwreck/meshes/propeller_visual.glb</uri></mesh></geometry>
        <gz:acoustic_lambert>-15</gz:acoustic_lambert>
        <gz:acoustic_specular>-3</gz:acoustic_specular>
        <gz:acoustic_specular_width>0.07</gz:acoustic_specular_width>
      </visual>
      <visual name="bell">
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>model://shipwreck/meshes/bell_visual.glb</uri></mesh></geometry>
        <gz:acoustic_lambert>-15</gz:acoustic_lambert>
        <gz:acoustic_specular>-3</gz:acoustic_specular>
        <gz:acoustic_specular_width>0.07</gz:acoustic_specular_width>
      </visual>
      <visual name="name_plate">
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>model://shipwreck/meshes/name_plate_visual.glb</uri></mesh></geometry>
        <gz:acoustic_lambert>-20</gz:acoustic_lambert>
        <gz:acoustic_specular>-5</gz:acoustic_specular>
        <gz:acoustic_specular_width>0.05</gz:acoustic_specular_width>
      </visual>
      <visual name="coal">
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>model://shipwreck/meshes/coal_visual.glb</uri></mesh></geometry>
        <gz:acoustic_lambert>-22</gz:acoustic_lambert>
      </visual>
      <collision name="aft_section_collision">
        <pose>-10.400 0 1.15 0 0 0</pose>
        <geometry><box><size>10.800 10.2 2.6</size></box></geometry>
      </collision>
      <collision name="boiler_collision">
        <pose>-2.000 0.000 1.800 0 1.5708 0</pose>
        <geometry><cylinder><radius>1.5</radius><length>4.0</length></cylinder></geometry>
      </collision>
      <collision name="engine_collision">
        <pose>-5.500 0.000 1.550 0 0 0</pose>
        <geometry><box><size>2 2 2.5</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
