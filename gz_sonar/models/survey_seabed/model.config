<?xml version="1.0"?>
<model>
  <name>survey_seabed</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>
  <author><name>Honu Robotics</name></author>
  <description>
    A gently undulating sandy seabed about 8 m down, 120 m by 80 m, for sonar survey runs. Visual only. The mesh is generated by make_seabed.py, which also gives the seabed's height anywhere for placing targets on it.
  </description>
</model>
