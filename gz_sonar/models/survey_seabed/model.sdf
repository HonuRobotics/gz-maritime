<?xml version="1.0"?>
<sdf version="1.12">
  <model name="survey_seabed">
    <static>true</static>
    <link name="link">
      <!-- The mesh is glTF-native (+Y up, +Z forward): roll 90 degrees, then
           yaw 90 degrees, puts it in Gazebo's frame. Generated by
           make_seabed.py; visual only, nothing rests on it. -->
      <visual name="seabed">
        <pose>0 0 0 1.5708 0 1.5708</pose>
        <geometry><mesh><uri>meshes/seabed.glb</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
