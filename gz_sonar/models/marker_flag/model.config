<?xml version="1.0"?>
<model>
  <name>marker_flag</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>
  <author><name>Honu Robotics</name></author>
  <description>
    A course marker for the cameras: a pole and a flag. The whole model is marked acoustically transparent, so sonars never see it. Static; the origin is the foot of the pole.
  </description>
</model>
