<?xml version="1.0"?>
<sdf version="1.12" xmlns:gz="http://gazebosim.org/schema">
  <model name="marker_flag" gz:acoustic_transparent="true">
    <static>true</static>
    <link name="link">
      <visual name="pole">
        <pose>0 0 1 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>2</length></cylinder></geometry>
        <material><diffuse>0.9 0.9 0.9 1</diffuse><ambient>0.9 0.9 0.9 1</ambient></material>
      </visual>
      <visual name="flag">
        <pose>0 0.25 1.8 0 0 0</pose>
        <geometry><box><size>0.01 0.5 0.3</size></box></geometry>
        <material><diffuse>0.9 0.2 0.1 1</diffuse><ambient>0.9 0.2 0.1 1</ambient></material>
      </visual>
    </link>
  </model>
</sdf>
