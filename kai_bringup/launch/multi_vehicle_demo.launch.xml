<?xml version="1.0"?>
<!--
  The multi vehicle demo: one ocean with one vehicle of each type on it.

  The simulation launch once, then the spawn launch once per vehicle, each
  through the vehicle's own generator: a BlueBoat at the origin, a BlueROV2
  six metres ahead and one metre down, and an X500 on the landing pad. Each
  vehicle gets its topics under its name, its bridge and state publisher in
  its namespace and its own TF prefix; the clock is bridged once.

  Needs bluerobotics_models and holybro_models built in the workspace. A
  vehicle from another type joins a running demo the same way: one more
  spawn launch with its generator or its files and a new name.

      ros2 launch kai_bringup multi_vehicle_demo.launch.xml
      ros2 launch kai_bringup multi_vehicle_demo.launch.xml gazebo_gui:=false
-->
<launch>
  <arg name="world" default="open_water.sdf"
       description="World SDF file name (resolved via GZ_SIM_RESOURCE_PATH)"/>
  <arg name="gazebo_gui" default="true" description="Launch the Gazebo GUI"/>
  <arg name="use_composition" default="true"
       description="Run Gazebo, the bridges and the state publishers in one container"/>

  <include file="$(find-pkg-share kai_bringup)/launch/simulation.launch.xml">
    <arg name="world" value="$(var world)"/>
    <arg name="gazebo_gui" value="$(var gazebo_gui)"/>
    <arg name="use_composition" value="$(var use_composition)"/>
  </include>

  <!-- Each spawn include sits in its own group so the variables one
       instance derives from its name do not leak into the next. -->
  <group>
    <include file="$(find-pkg-share kai_bringup)/launch/spawn_vehicle.launch.xml">
      <arg name="name" value="blueboat"/>
      <arg name="generator"
           value="$(find-pkg-prefix blueboat_gazebo)/lib/blueboat_gazebo/configure_vehicle.py --config $(find-pkg-share blueboat_description)/config/blueboat.yaml"/>
      <arg name="world" value=""/>
      <arg name="z" value="0.05"/>
      <arg name="use_composition" value="$(var use_composition)"/>
    </include>
  </group>

  <group>
    <include file="$(find-pkg-share kai_bringup)/launch/spawn_vehicle.launch.xml">
      <arg name="name" value="bluerov2"/>
      <arg name="generator"
           value="$(find-pkg-prefix bluerov2_gazebo)/lib/bluerov2_gazebo/configure_vehicle.py --config $(find-pkg-share bluerov2_description)/config/bluerov2.yaml"/>
      <arg name="world" value=""/>
      <arg name="x" value="6"/>
      <arg name="z" value="-1"/>
      <arg name="use_composition" value="$(var use_composition)"/>
    </include>
  </group>

  <group>
    <include file="$(find-pkg-share kai_bringup)/launch/spawn_vehicle.launch.xml">
      <arg name="name" value="x500"/>
      <arg name="generator"
           value="$(find-pkg-prefix x500_gazebo)/lib/x500_gazebo/configure_vehicle.py --config $(find-pkg-share x500_description)/config/x500.yaml"/>
      <arg name="world" value=""/>
      <arg name="x" value="8"/>
      <arg name="y" value="-8"/>
      <arg name="z" value="1.25"/>
      <arg name="use_composition" value="$(var use_composition)"/>
    </include>
  </group>
</launch>
