<launch>

  <!-- Pin gz-transport to loopback. On hosts with several interfaces
       (wifi, docker0, VPNs) the server and GUI can select different ones and
       discovery partially fails: the scene arrives but the wave field clock
       does not, freezing the GUI water flat at t = 0, which renders as a
       glassy mirror of the sky. Everything this launch starts runs on one
       machine, so loopback is correct; override gz_ip for distributed use. -->
  <arg name="gz_ip" default="127.0.0.1" description="GZ_IP for every gz process; override for multi machine setups"/>
  <set_env name="GZ_IP" value="$(var gz_ip)"/>

  <!-- Launch arguments -->
  <arg name="world" default="open_water.sdf" description="World SDF file name (resolved via GZ_SIM_RESOURCE_PATH)"/>
  <arg name="use_composition" default="true" description="Use composable nodes for GzServer and bridge"/>
  <arg name="gazebo_gui" default="true" description="Launch Gazebo GUI"/>
  <arg name="spawn_blueboat" default="true" description="Spawn the default BlueBoat at the surface"/>
  <arg name="spawn_bluerov2" default="true" description="Spawn the default BlueROV2 near the surface"/>

  <!-- 1. Gazebo Server (composable node) -->
  <gz_server
      world_sdf_file="$(var world)"
      container_name="ros_gz_container"
      create_own_container="true"
      use_composition="$(var use_composition)">
  </gz_server>

  <!-- 2. Gazebo GUI (separate process) -->
  <executable cmd="gz sim -g" output="screen" if="$(var gazebo_gui)"/>

  <!-- 3. ROS-Gazebo bridge (shares ros_gz_container) -->
  <ros_gz_bridge
      bridge_name="ros_gz_bridge"
      config_file="$(find-pkg-share kai_bringup)/config/ros_gz_bridge.yaml"
      container_name="ros_gz_container"
      create_own_container="false"
      use_composition="$(var use_composition)">
  </ros_gz_bridge>

  <!-- 4. Vehicles: the default generated models from bluerobotics_models,
       spawned side by side. Model names must match the world's per link
       buoyancy enables (blueboat::hull_displacement,
       bluerov2::buoyancy_displacement); renaming a vehicle here means it
       spawns without buoyancy and sinks. Spawn heights follow each package's
       own launch defaults: the boat drops onto the waterline, the ROV settles
       from just above it. -->
  <node pkg="ros_gz_sim" exec="create" name="spawn_blueboat" output="screen"
        if="$(var spawn_blueboat)"
        args="-name blueboat -x 0 -y 5 -z 0.05
              -file $(find-pkg-share blueboat_gazebo)/models/blueboat/model.sdf"/>
  <node pkg="ros_gz_sim" exec="create" name="spawn_bluerov2" output="screen"
        if="$(var spawn_bluerov2)"
        args="-name bluerov2 -x 0 -y -5 -z 0.5
              -file $(find-pkg-share bluerov2_gazebo)/model.sdf"/>

</launch>
