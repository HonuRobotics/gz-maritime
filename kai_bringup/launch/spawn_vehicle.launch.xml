<?xml version="1.0"?>
<!--
  Spawn one vehicle instance into a simulation that is already running.

  Any vehicle: the launch only needs, for the instance name, a model to
  spawn and, when the vehicle has them, a bridge config and a URDF.
  instantiate_vehicle.py produces them from one of two sources:

      generator:=CMD      a command that writes model.sdf, ros_gz_bridge.yaml and a
                          URDF for the name into a directory it is given
                          (see instantiate_vehicle.py for the call)
      xacro:=FILE         a model xacro rendered with name:=<name>, plus an
                          optional bridge:=FILE template with @name@ where the
                          name goes and an optional urdf:=FILE (xacro or plain),
                          handed to the model xacro as urdf_uri:=

  The model is spawned under the name at the given pose; the bridge and
  robot_state_publisher run in the /<name> namespace, the latter prefixing
  every TF frame with <name>/. The clock is not bridged here: the simulation
  launch does that once. Run it once per instance, after
  kai_bringup/launch/simulation.launch.xml:

      ros2 launch kai_bringup spawn_vehicle.launch.xml name:=boat_a y:=2 \
          generator:="<path to blueboat_gazebo's configure_vehicle.py, with its config option>"
-->
<launch>
  <arg name="name"
       description="Instance name: model name, topic prefix, ROS namespace and TF prefix; letters, digits and underscores"/>
  <arg name="generator" default=""
       description="Command run as `command --name &lt;name&gt; --out-dir &lt;instance_dir&gt;`"/>
  <arg name="xacro" default=""
       description="Model xacro rendered with name:=&lt;name&gt; (and urdf_uri:= when a URDF is given)"/>
  <arg name="bridge" default="" description="Bridge config template with @name@ where the name goes (with xacro:=)"/>
  <arg name="urdf" default="" description="URDF, xacro or plain, for robot_state_publisher (with xacro:=)"/>
  <arg name="x" default="0" description="Spawn position x (m)"/>
  <arg name="y" default="0" description="Spawn position y (m)"/>
  <arg name="z" default="0" description="Spawn position z (m)"/>
  <arg name="roll" default="0" description="Spawn roll (rad)"/>
  <arg name="pitch" default="0" description="Spawn pitch (rad)"/>
  <arg name="yaw" default="0" description="Spawn yaw (rad)"/>
  <arg name="world" default=""
       description="World to spawn into; empty picks the one running"/>
  <arg name="use_composition" default="true"
       description="Load the bridge and robot_state_publisher into the container of the simulation launch"/>
  <arg name="container_name" default="ros_gz_container"
       description="The container the simulation launch created"/>
  <arg name="instance_dir" default="$(env ROS_HOME $(env HOME)/.ros)/kai_bringup/$(var name)"
       description="Where the files of this instance are written"/>

  <!-- The instance files, produced now for the name into instance_dir. -->
  <let name="instantiate"
       value="$(find-pkg-prefix kai_bringup)/lib/kai_bringup/instantiate_vehicle.py --name $(var name) --out-dir $(var instance_dir)"/>
  <let name="vehicle_dir" value="$(var instance_dir)"/>
  <log_info message="$(command '$(var instantiate) --generator &quot;$(var generator)&quot; --xacro &quot;$(var xacro)&quot; --bridge &quot;$(var bridge)&quot; --urdf &quot;$(var urdf)&quot;')"/>
  <let name="has_bridge" value="$(command '$(var instantiate) --has-bridge')"/>
  <let name="has_urdf" value="$(command '$(var instantiate) --has-urdf')"/>

  <!-- The model, under the instance name, at the pose. create waits for the
       server and, given no world, spawns into the one running. -->
  <node pkg="ros_gz_sim" exec="create" name="spawn" namespace="$(var name)" output="screen"
        args="-world=$(var world) -name $(var name) -file $(var vehicle_dir)/model.sdf
              -x $(var x) -y $(var y) -z $(var z)
              -R $(var roll) -P $(var pitch) -Y $(var yaw)"/>

  <!-- This instance's bridge, in its namespace, without the clock. -->
  <group if="$(var has_bridge)">
    <ros_gz_bridge bridge_name="ros_gz_bridge"
                   namespace="$(var name)"
                   config_file="$(var vehicle_dir)/ros_gz_bridge.yaml"
                   container_name="$(var container_name)"
                   create_own_container="false"
                   use_composition="$(var use_composition)"/>
  </group>

  <!-- robot_state_publisher in the instance namespace, reading
       /<name>/joint_states and prefixing every frame with <name>/. -->
  <group if="$(var has_urdf)">
    <load_composable_node target="$(var container_name)" if="$(var use_composition)">
      <composable_node pkg="robot_state_publisher"
                       plugin="robot_state_publisher::RobotStatePublisher"
                       name="robot_state_publisher" namespace="$(var name)">
        <param name="robot_description" value="$(command 'cat $(var vehicle_dir)/robot.urdf')" type="str"/>
        <param name="frame_prefix" value="$(var name)/" type="str"/>
        <param name="use_sim_time" value="true" type="bool"/>
      </composable_node>
    </load_composable_node>
    <node pkg="robot_state_publisher" exec="robot_state_publisher"
          name="robot_state_publisher" namespace="$(var name)"
          unless="$(var use_composition)">
      <param name="robot_description" value="$(command 'cat $(var vehicle_dir)/robot.urdf')" type="str"/>
      <param name="frame_prefix" value="$(var name)/" type="str"/>
      <param name="use_sim_time" value="true" type="bool"/>
    </node>
  </group>
</launch>
