<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gz_lens_drops</name>
  <version>0.1.0</version>
  <description>Water drops on a camera's lens for Gazebo Sim: a seeded model of drops driven by the rain rate, drawn on the GPU as a render pass on the camera sensor.</description>
  <maintainer email="acordero@honurobotics.com">Alejandro Hernandez Cordero</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_math_vendor</depend>
  <depend>gz_common_vendor</depend>
  <!-- The set and state topics. -->
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>
  <!-- The render pass, behind a dlopen'd bridge to Ogre Next. -->
  <depend>gz_rendering_vendor</depend>
  <depend>gz_ogre_next_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
