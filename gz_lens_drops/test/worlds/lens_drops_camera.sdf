<?xml version="1.0"?>
<!--
  A camera 1 m up looking at three coloured shapes on a blue plane under a
  pale sky, rendered headless, with the lens drops system and no rain: the
  test makes it rain on the set topic. A drop over the horizon or a shape
  changes many pixels. No sensor noise, so a dry lens on a still scene
  gives the same image twice.
-->
<sdf version="1.9">
  <world name="lens_drops_camera">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.6 0.6 0.6</ambient><background>0.5 0.7 0.9</background></scene>
    <light type="directional" name="sun">
      <direction>-0.3 0.2 -1</direction>
      <diffuse>1 1 1 1</diffuse>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.1 0.3 0.5 1</ambient><diffuse>0.1 0.3 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="red">
      <static>true</static>
      <pose>8 2 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1 1 2</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="green">
      <static>true</static>
      <pose>10 -2 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>2</length></cylinder></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="yellow">
      <static>true</static>
      <pose>6 0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="camera">
      <static>true</static>
      <pose>0 0 1 0 0 0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <topic>/lens_drops_camera/image</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>320</width><height>180</height></image>
            <clip><near>0.1</near><far>300</far></clip>
          </camera>
          <plugin filename="gz-maritime-lens-drops-system"
                  name="gz::sim::maritime::LensDrops">
            <focus>0.9</focus>
            <dry_time>3600</dry_time>
            <seed>1</seed>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
