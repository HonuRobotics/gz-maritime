<?xml version="1.0"?>
<!--
  A level camera 1 m over a dark plane under a bright sky, so the horizon
  crosses the middle of the image, rendered headless, with the lens drops
  system, no rain, a sharp focus, the mask on, and the largest slide radius
  so a drop put on the lens stays where it is put. A drop across the
  horizon is a lens: it must show the dark sea in its upper half and the
  bright sky in its lower half.
-->
<sdf version="1.9">
  <world name="lens_drops_horizon">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>1 1 1</ambient><background>0.9 0.9 0.9</background></scene>
    <light type="directional" name="sun">
      <direction>0 0 -1</direction>
      <diffuse>0.2 0.2 0.2 1</diffuse>
    </light>

    <model name="sea">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="camera">
      <static>true</static>
      <pose>0 0 1 0 0 0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <topic>/lens_drops_horizon/image</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>320</width><height>180</height></image>
            <clip><near>0.1</near><far>3000</far></clip>
          </camera>
          <plugin filename="gz-maritime-lens-drops-system"
                  name="gz::sim::maritime::LensDrops">
            <focus>1</focus>
            <mask>true</mask>
            <dry_time>3600</dry_time>
            <slide_radius>0.2</slide_radius>
            <seed>1</seed>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
