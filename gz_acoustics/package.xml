<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gz_acoustics</name>
  <version>0.1.0</version>
  <description>Behavioural underwater acoustics for Gazebo Sim: pingers on any link that ping on a schedule, at a frequency, and receivers on any link that report the direction each ping they hear came from, after the delay of the speed of sound, within a band and a reach, with noise. No propagation model.</description>
  <maintainer email="acordero@honurobotics.com">Alejandro Hernandez Cordero</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_math_vendor</depend>
  <depend>gz_common_vendor</depend>
  <!-- The set topics, the readings and the ground truth. -->
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>
  <!-- The receiver is a gz-sensors custom sensor, with its noise. -->
  <depend>gz_sensors_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
