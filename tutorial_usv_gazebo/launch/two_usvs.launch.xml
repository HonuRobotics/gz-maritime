<?xml version="1.0"?>
<!--
  Two tutorial USVs on one ocean: the simulation part once, the spawn part
  twice with different names. Each boat has its own topics (/boat_a/...,
  /boat_b/...), its own namespace and its own TF prefix, and floats by the
  collisions its model marks, so nothing about either is in the world.

  Each spawn include sits in its own group so the launch variables one
  instance derives from its name do not leak into the other.

      ros2 launch tutorial_usv_gazebo two_usvs.launch.xml
-->
<launch>
  <arg name="world" default="open_water.sdf"
       description="World SDF file name (resolved via GZ_SIM_RESOURCE_PATH)"/>
  <arg name="gazebo_gui" default="true" description="Launch the Gazebo GUI"/>
  <arg name="use_composition" default="true"
       description="Run gz_server, the bridges and the state publishers in one container"/>

  <include file="$(find-pkg-share kai_bringup)/launch/simulation.launch.xml">
    <arg name="world" value="$(var world)"/>
    <arg name="gazebo_gui" value="$(var gazebo_gui)"/>
    <arg name="use_composition" value="$(var use_composition)"/>
  </include>

  <group>
    <include file="$(find-pkg-share tutorial_usv_gazebo)/launch/spawn.launch.xml">
      <arg name="name" value="boat_a"/>
      <arg name="y" value="2"/>
      <arg name="use_composition" value="$(var use_composition)"/>
    </include>
  </group>

  <group>
    <include file="$(find-pkg-share tutorial_usv_gazebo)/launch/spawn.launch.xml">
      <arg name="name" value="boat_b"/>
      <arg name="y" value="-2"/>
      <arg name="use_composition" value="$(var use_composition)"/>
    </include>
  </group>
</launch>
