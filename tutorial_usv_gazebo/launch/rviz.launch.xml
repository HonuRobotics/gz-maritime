<?xml version="1.0"?>
<!--
  RViz on one tutorial USV instance in a running simulation.

  In a simulation every TF frame carries the instance name and the
  description is published in its namespace, so RViz needs a config pointed
  at that instance: fixed frame <name>/base_link, description topic
  /<name>/robot_description and the RobotModel display's TF Prefix, which
  cannot be given on the command line. configure_vehicle.py writes that
  config next to the instance's model, from the description package's own;
  this launch starts RViz on it with simulation time.

      ros2 launch tutorial_usv_gazebo rviz.launch.xml
      ros2 launch tutorial_usv_gazebo rviz.launch.xml name:=boat_a
-->
<launch>
  <arg name="name" default="tutorial_usv"
       description="Instance to look at: its TF prefix, namespace and topics"/>

  <let name="vehicle_dir"
       value="$(command '$(find-pkg-prefix tutorial_usv_gazebo)/lib/tutorial_usv_gazebo/configure_vehicle.py --name $(var name) --cache')"/>

  <node pkg="rviz2" exec="rviz2" name="rviz2" namespace="$(var name)"
        output="screen" args="-d $(var vehicle_dir)/tutorial_usv.rviz">
    <param name="use_sim_time" value="true" type="bool"/>
  </node>
</launch>
