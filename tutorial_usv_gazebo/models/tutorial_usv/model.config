<?xml version="1.0"?>
<model>
  <name>tutorial_usv</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>

  <author>
    <name>Alejandro Hernandez Cordero</name>
    <email>acordero@honurobotics.com</email>
  </author>

  <description>
    Simulation model of the gz-maritime tutorial USV, a 1 m twin-hull
    catamaran: the tutorial_usv_description URDF merged with its displacement
    volume, thrusters, hydrodynamics and sensors. The default instance, named
    tutorial_usv; configure_vehicle.py --name generates any other. Spawn it
    into a world running gz_buoyancy, or include it as model://tutorial_usv.
  </description>
</model>
