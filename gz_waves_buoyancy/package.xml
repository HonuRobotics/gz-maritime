<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gz_waves_buoyancy</name>
  <version>0.1.0</version>
  <description>Buoyancy on the waves for Gazebo Sim: a world system that floats every collision marked gz:buoyancy="true" on the world's wave field instead of flat water, pushing each shape up by the water under a plane fitted to the surface around it.</description>
  <maintainer email="acordero@honurobotics.com">Alejandro Hernandez Cordero</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_math_vendor</depend>
  <depend>gz_common_vendor</depend>
  <depend>sdformat_vendor</depend>
  <!-- The wave field it floats things on. -->
  <depend>gz_waves</depend>
  <!-- The marked collisions, found as the wind and current find theirs. -->
  <depend>gz_marked_shapes</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- The wave engines the tests use. -->
  <test_depend>gz_waves_provider_gerstner</test_depend>
  <test_depend>gz_waves_provider_fft</test_depend>
  <!-- The flat buoyancy, to show the two never push together. -->
  <test_depend>gz_buoyancy</test_depend>
  <!-- The waves' water velocity test: the system that damps against it. -->
  <test_depend>gz_hydrodynamics</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
