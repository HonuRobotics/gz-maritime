<?xml version="1.0"?>
<!--
  The same wave, but physics on flat water (gz_buoyancy): the wave is drawn only, and neither sphere moves.
-->
<sdf version="1.9" xmlns:gz="http://gazebosim.org/schema">
  <world name="waves_drawn">
    <physics name="fast" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <!-- One long wave along +x, 0.3 m high, 4 s, ramping in over 2 s. -->
    <plugin filename="gz-sim-waves-gerstner-system"
            name="gz::sim::systems::GerstnerWaves">
      <update_rate>30</update_rate>
      <wave>
        <model>CWR</model>
        <number>1</number>
        <amplitude>0.3</amplitude>
        <period>4</period>
        <direction>0</direction>
        <steepness>0</steepness>
        <tau>2</tau>
      </wave>
    </plugin>
    <plugin filename="gz-maritime-buoyancy-system"
            name="gz::sim::maritime::Buoyancy">
      <graded_buoyancy>
        <default_density>1025</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable_by_default>false</enable_by_default>
    </plugin>
    <!-- Two neutral spheres with linear damping, one just under the water
         and one deep, at the same x so the wave reaches both together. -->
    <model name="shallow">
      <pose>0 0 -0.6 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>34.348</mass>
          <inertia>
            <ixx>0.55</ixx><iyy>0.55</iyy><izz>0.55</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="hull" gz:buoyancy="true">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
          <surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface>
        </collision>
      </link>
      <plugin filename="gz-maritime-hydrodynamics-system"
              name="gz::sim::maritime::Hydrodynamics">
        <link_name>link</link_name>
        <xU>-60</xU> <yV>-60</yV> <zW>-60</zW>
        <kP>-5</kP> <mQ>-5</mQ> <nR>-5</nR>
      </plugin>
    </model>
    <model name="deep">
      <pose>0 4 -5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>34.348</mass>
          <inertia>
            <ixx>0.55</ixx><iyy>0.55</iyy><izz>0.55</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="hull" gz:buoyancy="true">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
          <surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface>
        </collision>
      </link>
      <plugin filename="gz-maritime-hydrodynamics-system"
              name="gz::sim::maritime::Hydrodynamics">
        <link_name>link</link_name>
        <xU>-60</xU> <yV>-60</yV> <zW>-60</zW>
        <kP>-5</kP> <mQ>-5</mQ> <nR>-5</nR>
      </plugin>
    </model>
  </world>
</sdf>
