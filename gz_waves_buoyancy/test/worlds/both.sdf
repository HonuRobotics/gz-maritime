<?xml version="1.0"?>
<!--
  The flat buoyancy and the wave buoyancy in one world: the wave buoyancy
  steps aside, and the box floats once, at the flat draft.
-->
<sdf version="1.9" xmlns:gz="http://gazebosim.org/schema">
  <world name="both">
    <physics name="fast" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <!-- The flat buoyancy as every kai_gazebo world runs it: the wave
         buoyancy must step aside, or the box floats on twice its buoyancy. -->
    <plugin filename="gz-maritime-buoyancy-system"
            name="gz::sim::maritime::Buoyancy">
      <graded_buoyancy>
        <default_density>1025</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable_by_default>false</enable_by_default>
    </plugin>
    <!-- One long wave along +x: 4 s, so 25 m long, ramping in over 2 s. -->
    <plugin filename="gz-sim-waves-gerstner-system"
            name="gz::sim::systems::GerstnerWaves">
      <update_rate>30</update_rate>
      <wave>
        <model>CWR</model>
        <number>1</number>
        <amplitude>0</amplitude>
        <period>4</period>
        <direction>0</direction>
        <steepness>0</steepness>
        <tau>2</tau>
      </wave>
    </plugin>
    <plugin filename="gz-maritime-wave-buoyancy-system"
            name="gz::sim::maritime::WaveBuoyancy">
      <water_density>1025</water_density>
      <air_density>1</air_density>
      <water_level>0</water_level>
    </plugin>
    <!-- A 1 x 1 x 0.4 m box of 200 kg: on flat water its draft is
         200 / 1025 = 0.195 m, its centre 0.005 m above the water. -->
    <model name="floater">
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>200</mass>
          <inertia>
            <ixx>19.3</ixx><iyy>19.3</iyy><izz>33.3</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="hull" gz:buoyancy="true">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>1 1 0.4</size></box></geometry>
          <surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface>
        </collision>
      </link>
    </model>
  </world>
</sdf>
