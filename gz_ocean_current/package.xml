<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gz_ocean_current</name>
  <version>0.1.0</version>
  <description>The ocean current of a world for Gazebo Sim, as a recipe any system can query at a point: an OceanCurrentfield component naming a current model and its parameters, a registry of models, a sampler, and a world system that owns the recipe and publishes it as ground truth.</description>
  <maintainer email="caguero@honurobotics.com">Carlos Agüero</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_math_vendor</depend>
  <depend>gz_common_vendor</depend>
  <!-- The ground truth topic. -->
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
