<?xml version="1.0"?>
<!--
  A world whose wind comes from the wind system's own parameters: 5 m/s from
  the west (270 degrees clockwise from north), so it blows towards +x. No
  gravity and no damping: the only thing that moves the marked 1 m, 100 kg
  box is the wind, about 0.15 m/s after one second, like marked_box in
  windage.sdf.
-->
<sdf version="1.9" xmlns:gz="http://gazebosim.org/schema">
  <world name="windfield">
    <gravity>0 0 0</gravity>
    <physics name="fast" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-maritime-wind-system"
            name="gz::sim::maritime::Wind">
      <speed>5</speed>
      <direction>270</direction>
    </plugin>
    <model name="marked_box">
      <pose>0 0 0.5 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>100</mass>
          <inertia>
            <ixx>16.667</ixx><iyy>16.667</iyy><izz>16.667</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="windage" gz:wind="true">
          <geometry><box><size>1 1 1</size></box></geometry>
          <surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface>
        </collision>
      </link>
    </model>
  </world>
</sdf>
