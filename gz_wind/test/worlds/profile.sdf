<?xml version="1.0"?>
<!--
  A 5 m/s wind from the west at the 10 m reference height, with the open sea
  roughness length, 0.0002 m, so the wind falls off towards the water as
  ln(h / z0) / ln(10 / z0). high_box is centred at 10 m and sees the whole
  wind; low_box is centred at 1 m and sees 0.79 of it, so 0.62 of the force.
  No gravity: the boxes stay at their heights.
-->
<sdf version="1.9" xmlns:gz="http://gazebosim.org/schema">
  <world name="profile">
    <gravity>0 0 0</gravity>
    <physics name="fast" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-maritime-wind-system"
            name="gz::sim::maritime::Wind">
      <speed>5</speed>
      <direction>270</direction>
      <roughness_length>0.0002</roughness_length>
      <reference_height>10</reference_height>
    </plugin>
    <model name="high_box">
      <pose>0 0 10 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>100</mass>
          <inertia>
            <ixx>16.667</ixx><iyy>16.667</iyy><izz>16.667</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="windage" gz:wind="true">
          <geometry><box><size>1 1 1</size></box></geometry>
          <surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface>
        </collision>
      </link>
    </model>
    <model name="low_box">
      <pose>0 5 1 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>100</mass>
          <inertia>
            <ixx>16.667</ixx><iyy>16.667</iyy><izz>16.667</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="windage" gz:wind="true">
          <geometry><box><size>1 1 1</size></box></geometry>
          <surface><contact><collide_bitmask>0x00</collide_bitmask></contact></surface>
        </collision>
      </link>
    </model>
  </world>
</sdf>
