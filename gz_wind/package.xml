<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gz_wind</name>
  <version>0.1.0</version>
  <description>Windage on marked collisions: a world system that pushes on the shapes a vehicle marks with gz:wind="true", whatever the vehicle is called and whenever it appears.</description>
  <maintainer email="caguero@honurobotics.com">Carlos Agüero</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <depend>gz_math_vendor</depend>
  <depend>gz_common_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>gz_transport_vendor</test_depend>
  <test_depend>gz_msgs_vendor</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
