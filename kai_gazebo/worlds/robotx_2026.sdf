<?xml version="1.0"?>
<!--
  The Maritime RobotX Challenge 2026 at Marina Bay, Singapore (8 to 14
  November 2026): marina_bay.sdf with the four courses, A to D from the
  Promontory, set up as at the venue, and the pontoon dressed for the
  competition. Generated by Honu Robotics' RobotX 2026 asset tools
  (world_2026.py), which also build the models on Fuel.

  Each course is 30 m wide, the courses 36 m apart, running from 5 m off the
  Marina Boulevard seawall to 5 m off the pontoon. In each: the boundary
  buoys with the course's letter, the Task 1 buoy field, the Task 2 buoys
  over the pipeline with a pinger under each, two delivery platforms with a
  red, a green and a blue tin on each, and the dock by the pontoon. At the
  pontoon, each course's launch area: the UAV launch and landing platform
  and two USV launch fingers. Along the pontoon, ROBOTX 2026 banners,
  canopies and feather flags; on the promenade, the COURSE A to D tents.
  Every element is static here (the models are not) but the tins, which the
  UAVs pick up. The elements come from Gazebo Fuel (honuRobotics, collection
  RobotX_2026); the water ships with kai_gazebo.

  Start points, the middle of each course's seawall end, facing the pontoon:
      course A   -53.0    0.0  0  0 0 0.98
      course B   -23.0  -20.0  0  0 0 0.98
      course C     7.0  -40.0  0  0 0 0.98
      course D    37.0  -60.0  0  0 0 0.98
  The day is the venue's: overcast (robotx_overcast_sky inside the site's
  dome), soft light without hard shadows, and olive water with breeze
  ripples reflecting the grey sky (water_surface_overcast). The rest as
  marina_bay.sdf: the world contract of open_water.sdf, the waterline at
  z = 0, fresh water, sea state 0 to 2.
-->
<sdf version="1.12">
  <world name="default">

    <!-- Physics -->
    <physics name="default_physics" type="dart">
      <max_step_size>0.004</max_step_size>
      <!-- <real_time_factor>0</real_time_factor> -->
    </physics>

    <!-- Spherical coordinates of the site, required by the magnetometer
         system (World Magnetic Model at this lat/lon) and by the NavSat
         system (fixes relative to this origin). -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>1.28090</latitude_deg>
      <longitude_deg>103.85535</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Scene: a soft, slightly blue ambient, the light of the tropical sky,
         low enough that the sun shapes the towers (a white ambient lights
         every face alike and the city goes flat), the same for camera
         sensors and the GUI. No <sky>: gz-rendering draws only its built-in
         sky cube, whatever <cubemap_uri> says; the sky is a photographed one
         on a dome in the marina_bay model, and the background colour shows
         only past its edge. -->
    <scene>
      <ambient>0.88 0.89 0.90</ambient>
      <background>0.78 0.80 0.83</background>
      <grid>false</grid>
    </scene>

    <!-- The sun of a November mid afternoon in Singapore, about 2:30 pm:
         high in the west south west (azimuth 240 degrees, 50 degrees up,
         where it is in the sky dome's photograph), so it
         lights the west faces of Marina Bay Sands across the water and the
         towers throw their shadows over the bay towards the courses. -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 200 0 0 0</pose>
      <diffuse>0.50 0.50 0.50 1</diffuse>
      <specular>0.12 0.12 0.12 1</specular>
      <attenuation>
        <range>10000</range>
        <constant>0.9</constant>
        <linear>0.0</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
      <direction>0.557 0.321 -0.766</direction>
    </light>

    <!-- Core systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
    </plugin>

    <plugin
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
      <use_units_gauss>false</use_units_gauss>
      <use_earth_frame_ned>false</use_earth_frame_ned>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <plugin
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <!-- Barometers: the air pressure system, for aerial vehicles such as the
         X500 that carry an air_pressure sensor. -->
    <plugin
      filename="gz-sim-air-pressure-system"
      name="gz::sim::systems::AirPressure">
    </plugin>

    <!-- Buoyancy (gz_buoyancy): graded, fresh water (1000 kg/m^3: the
         Marina Reservoir) below z = 0
         and air (1 kg/m^3) above. The interface is the FLAT z = 0 plane, not
         the wave surface: for vehicle physics the waves are visual only.
         Coupling buoyancy to the waves is the job of the future
         gz_waves_buoyancy consumer (WAVES_DESIGN.md §11).

         This world names no vehicle. <enable_by_default> false and no
         <enable> list: the world only describes the fluid, and a link floats
         by the collisions it marks as buoyancy geometry with
         gz:buoyancy="true" (gz-sim commit 229ec07e), whatever name its
         model was spawned under. A vehicle's contact geometry stays contact
         geometry, and a mark needs a zero <collide_bitmask> so the
         displacement volume touches nothing. gz_buoyancy carries that change
         until a Gazebo release with it reaches ROS; then this block switches
         to gz-sim-buoyancy-system / gz::sim::systems::Buoyancy unchanged. -->
    <plugin
      filename="gz-maritime-buoyancy-system"
      name="gz::sim::maritime::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable_by_default>false</enable_by_default>
    </plugin>

    <!-- Wind (gz_wind). The world owns the wind: <speed> in m/s at 10 m and
         the <direction> it comes from, in degrees clockwise from north (270
         is a wind from the west). Change it while running on the topic
         /world/default/wind/set (keys speed and direction), bridged to ROS
         by the simulation launch. The system keeps the wind as a recipe on
         the world, writes it where Gazebo's rotor, wing and air speed systems
         read it, publishes it on /world/default/wind_info, and pushes on
         the collisions a vehicle marks gz:wind="true", by the part of each
         shape above the water. Like buoyancy, the world names no vehicle.
         Gusts on
         the speed and the direction (<speed_gust>, <direction_gust> and
         their times, <seed>) are listed in the reference docs. -->
    <plugin
      filename="gz-maritime-wind-system"
      name="gz::sim::maritime::Wind">
      <speed>0</speed>
      <direction>0</direction>
      <!-- The speed is at 10 m, as in weather reports; over the sea the wind
           falls off towards the water with this roughness length. -->
      <reference_height>10</reference_height>
      <roughness_length>0.0002</roughness_length>
    </plugin>

    <!-- Ocean current (gz_ocean_current). The world owns the current: <speed>
         in m/s and the <direction> it sets towards, in degrees clockwise from
         north (90 sets east, towards +x; the opposite convention from the
         wind, which is given by where it comes from). Set here, and changed
         while running on the topic /world/default/ocean_current/set (keys
         speed and direction), bridged to ROS by the simulation launch. The
         system keeps it as a recipe on the world, which any system asks at
         a point, and publishes it on /world/default/ocean_current_info.
         Slack by default.
         Marina Reservoir: no tide behind the barrage, so the water is still. -->
    <plugin
      filename="gz-maritime-ocean-current-system"
      name="gz::sim::maritime::OceanCurrent">
      <speed>0</speed>
      <direction>0</direction>
    </plugin>

    <!-- Acoustics (gz_acoustics): pingers ping, receivers hear them, both
         found on any model (a pinger is the gz-maritime-acoustic-pinger-system
         plugin on a link, model://acoustic_pinger is one ready made; a
         receiver is a custom sensor, gz:type="acoustic_receiver"). Silent
         until a pinger shows up; the world names neither. Each ping travels
         at the speed of sound and is heard below the water only. -->
    <plugin
      filename="gz-maritime-acoustics-system"
      name="gz::sim::maritime::Acoustics">
      <speed_of_sound>1500</speed_of_sound>
      <water_level>0</water_level>
    </plugin>

    <!-- ==================================================================
         WAVE SOURCE — the engine is the plugin's identity. Keep exactly ONE of
         the two <plugin> blocks below active and comment the other out. Both
         blocks are deliberately comment-free so either can be wrapped in an XML
         comment cleanly (XML comments cannot nest). Per-parameter notes live in
         the comment directly above each block.
         ================================================================== -->

    <!-- Wave source. Two engines are available: FFT (EncinoWaves spectral,
         higher fidelity) is active here; Gerstner (analytic sum of component
         waves) is the commented alternative below. Full parameter lists and the
         <sea_state> precedence rules live in each plugin's documentation.

         Both blocks set sea state 1 (rippled, Hs 5 cm). Vehicles float on the
         flat z = 0 plane of the buoyancy system above, not on this surface, so
         a rougher sea only shows waves passing through hulls that do not ride
         them. Not 0: a glassy sea mirrors the sky and reads as white. Raise it
         at runtime through /world/default/wave/set_parameters (gz.msgs.Param,
         key sea_state; WAVES_DESIGN.md §8). -->
    <plugin filename="gz-sim-waves-fft-system"
            name="gz::sim::systems::FftWaves">
      <update_rate>30</update_rate>
      <wave>
        <!-- Simplest control: a WMO sea-state code (0-9) sets the whole sea. It
             overrides <period>/<gain> (1 = rippled, 3 = slight, 5 = rough,
             0 = glassy). For a hand-tuned sea, comment <sea_state> and uncomment
             the advanced block (delete the two comment markers wrapping it). -->
        <sea_state>1</sea_state>
        <!-- How far the water is drawn around the water surface model, in
             200 m tiles: 6 is a 2.6 km square, the bay, the Kallang Basin
             and the sea past the barrage as far as they show. -->
        <tiles_radius>6</tiles_radius>

        <!-- Advanced / manual setup (a working configuration). <period> sets
             wind speed; <gain> is the amplitude multiplier (9.5 = dramatic and
             intentionally unphysical, ~1.0 = physical Hs); <tile_size> and
             <grid_size> are the periodic domain and FFT resolution; <choppiness>
             sharpens crests; <direction> is parsed but not yet applied
             (EncinoWaves assumes wind along +X). -->
        <!--
        <period>3.2</period>
        <gain>9.5</gain>
        <direction>2.356</direction>
        <tau>2.0</tau>
        <tile_size>256</tile_size>
        <grid_size>128</grid_size>
        <seed>42</seed>
        <choppiness>-2.0</choppiness>
        -->
      </wave>
    </plugin>

    <!-- Gerstner alternative (gz-sim-waves-gerstner-system): analytic sum of
         component waves. To use it instead of FFT, comment the <plugin> above
         and uncomment this one. <sea_state> drives the height; every other
         tag below is the engine default, kept explicit for discoverability.
         Extras like <direction> or <steepness> can be added per the plugin
         docs (they are NOT defaults, so adding them changes the sea). -->
    <!--
    <plugin filename="gz-sim-waves-gerstner-system"
            name="gz::sim::systems::GerstnerWaves">
      <update_rate>30</update_rate>
      <wave>
        <sea_state>1</sea_state>
        <model>PMS</model>
        <number>3</number>
        <angle>0.4</angle>
        <scale>1.1</scale>
        <tau>2.0</tau>
        <grid_size>128</grid_size>
      </wave>
    </plugin>
    -->

    <!-- GUI -->
    <gui fullscreen="0">
      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.62 0.64 0.68</ambient_light>
        <background_color>0.0 0.7 0.8</background_color>
        <!-- Above the seawall behind course A, looking over courses A and B
             to the pontoon. -->
        <camera_pose>-49.7 -29.4 16.0 0 0.246 0.745</camera_pose>
        <camera_clip>
          <near>0.1</near>
          <far>50000</far>
        </camera_clip>
      </plugin>

      <!-- Scene management plugins -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
        <warn_on_action_failure>false</warn_on_action_failure>
      </plugin>

      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <!-- World control -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>

      <!-- World statistics -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="ComponentInspector" name="Component Inspector">
        <gz-gui>
          <title>Inspector</title>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>
      <!-- Ocean current and wind panels (gz_maritime_gui): change each
           field, and draw it as arrows, off until turned on in its panel. -->
      <plugin filename="OceanCurrentPanel" name="Ocean current">
        <gz-gui>
          <title>Ocean current</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <display>off</display>
      </plugin>

      <plugin filename="WindPanel" name="Wind">
        <gz-gui>
          <title>Wind</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <display>off</display>
      </plugin>

      <!-- Scenarios (gz_maritime_gui): presets that ramp the current and the
           wind, and a demo that steps through them. -->
      <plugin filename="ScenarioPanel" name="Scenarios">
        <gz-gui>
          <title>Scenarios</title>
          <property type="string" key="state">docked</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- The site: the bay's seawalls and land, the city and its landmarks,
         one static model in the world frame. Its collisions are boxes (the
         seawall, the land behind it and the buildings near the venue), so
         vehicles touch the quays and aerial vehicles the buildings. The
         event's pontoon, gangway and berth are included below. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/marina_bay</uri>
    </include>

    <!-- The Singapore Flyer's wheel, turning: once in 105 s, faster than the
         real wheel's 30 minutes so it shows on camera. Its speed is the
         model's JointController; change it while running with
         gz topic -t /model/singapore_flyer/joint/axle/cmd_vel -m gz.msgs.Double -p 'data: 0.0035'
         (the real speed), or 0 to stop it. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/marina_bay_flyer</uri>
    </include>

    <!-- The drawn water: one water surface centred on the bay. Buoyancy
         does not depend on it: it is the flat z = 0 plane everywhere, and
         the land hides the water under it. -->
    <include>
      <pose>250 300 0 0 0 0</pose>
      <uri>model://water_surface_overcast</uri>
    </include>

    <!-- The reservoir's bed, modelled (no survey is open): optional, for
         underwater vehicles, sonars and DVLs, or a hull grounding. -->
    <!--
    <include>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/marina_bay_seabed</uri>
    </include>
    -->

    <!-- The RobotX 2026 courses and venue dressing (world_2026.py) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/robotx_overcast_sky</uri>
    </include>
    <include>
      <name>a_boundary_0</name>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/robotx_robobuoy_a</uri>
      <pose>-66.315 5.478 0.000 0 0 -0.1883</pose>
      <static>true</static>
    </include>
    <include>
      <name>a_boundary_1</name>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/robotx_robobuoy_a</uri>
      <pose>-42.853 -10.173 0.000 0 0 0.3117</pose>
      <static>true</static>
    </include>
    <include>
      <name>a_boundary_2</name>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/robotx_robobuoy_a</uri>
      <pose>-22.663 20.094 0.000 0 0 0.8117</pose>
      <static>true</static>
    </include>
    <include>
      <name>a_boundary_3</name>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/robotx_robobuoy_a</uri>
      <pose>-46.125 35.745 0.000 0 0 1.3117</pose>
      <static>true</static>
    </include>
    <include>
      <name>a_task1_0</name>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/robotx_robobuoy_task1</uri>
      <pose>-57.313 15.188 0.000 0 0 -0.5883</pose>
      <static>true</static>
    </include>
    <include>
      <name>a_task1_1</name>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/robotx_robobuoy_task1</uri>
      <pose>-54.019 10.664 0.000 0 0 -0.2883</pose>
      <static>true</static>
    </include>
    <include>
      <name>a_task1_2</name>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/robotx_robobuoy_task1</uri>
      <pose>-48.041 10.165 0.000 0 0 0.0117</pose>
      <static>true</static>
    </include>
    <include>
      <name>a_task1_3</name>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/robotx_robobuoy_task1</uri>
      <pose>-52.757 17.964 0.000 0 0 0.3117</pose>
      <static>true</static>
    </include>
    <include>
      <name>a_task1_4</name>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/robotx_robobuoy_task1</uri>
      <pose>-48.926 14.245 0.000 0 0 0.6117</pose>
      <static>true</static>
    </include>
    <include>
      <name>a_task1_5</name>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/robotx_robobuoy_task1</uri>
      <pose>-43.215 13.344 0.000 0 0 0.9117</pose>
      <static>true</static>
    </include>
    <include>
      <name>a_task1_6</name>
