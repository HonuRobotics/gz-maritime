<?xml version="1.0"?>
<!--
  Sydney International Regatta Centre, Penrith: the Virtual RobotX (VRX)
  2022 to 2024 venue, the 2.3 km rowing course of the 2000 Olympics among
  the Penrith Lakes, under the foothills of the Blue Mountains.

  This is the lite tier: coarse terrain, every building with a flat roof, no
  trees, 2048 pixel ground and a 4096 pixel sky, no shadows and less of the
  animated water. For CI, integrated GPUs and many vehicles.
  sydney_regatta.sdf is the full tier, with the same collisions and
  coordinates.

  The water is a rowing lake: fresh, flat and sheltered, so keep the
  sea state between 0 and 2.

  The same world contract as open_water.sdf (the systems every vehicle
  needs, gz-maritime's buoyancy reading marked collisions, the waterline at
  z = 0, the wave field for the drawn sea), with this site's coordinates
  (the origin of the VRX or VORC world it replaces). A good start point is
  -532 180 0 0 0 0:

      ros2 launch kai_bringup simulation.launch.xml world:=sydney_regatta_lite.sdf
      ros2 launch kai_bringup spawn_vehicle.launch.xml name:=boat_a x:=-532 y:=180 ...

  The site and its seabed are models on Gazebo Fuel
  (https://app.gazebosim.org/honurobotics, CC BY 4.0), downloaded the first
  time the world loads and cached after that. The water ships with
  kai_gazebo, next to gz_waves_rendering's shaders it uses. Terrain, shore
  and city from OpenStreetMap (c) OpenStreetMap contributors, ODbL 1.0,
  Sentinel-2 cloudless 2016 by EOX (CC BY 4.0) and the AWS Terrain Tiles;
  see kai_gazebo/NOTICE.
-->
<sdf version="1.12">
  <world name="default">

    <!-- Physics -->
    <physics name="default_physics" type="dart">
      <max_step_size>0.004</max_step_size>
      <!-- <real_time_factor>0</real_time_factor> -->
    </physics>

    <!-- Spherical coordinates of the site, required by the magnetometer
         system (World Magnetic Model at this lat/lon) and by the NavSat
         system (fixes relative to this origin). -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>-33.724223</latitude_deg>
      <longitude_deg>150.679736</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Scene: a soft ambient, the light of the sky, low enough that the
         sun shapes the land and the buildings, the same for camera sensors
         and the GUI. No <sky>: gz-rendering draws only its built-in sky
         cube, whatever <cubemap_uri> says; the sky is a photographed one on
         a dome in the site model, and the background colour shows only
         past its edge (cameras whose far clip is under 3.8 km). -->
    <scene>
      <ambient>0.6 0.62 0.66</ambient>
      <background>0.62 0.72 0.86</background>
      <grid>false</grid>
    </scene>

    <!-- The sun where it is in the sky dome's photograph: azimuth 300 degrees, 30 degrees up. No shadows in the lite tier. -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 200 0 0 0</pose>
      <diffuse>1 0.97 0.92 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <attenuation>
        <range>10000</range>
        <constant>0.9</constant>
        <linear>0.0</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
      <direction>0.750 -0.433 -0.500</direction>
    </light>

    <!-- Core systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
    </plugin>

    <plugin
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
      <use_units_gauss>false</use_units_gauss>
      <use_earth_frame_ned>false</use_earth_frame_ned>
    </plugin>

    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <plugin
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <!-- Barometers: the air pressure system, for aerial vehicles such as the
         X500 that carry an air_pressure sensor. -->
    <plugin
      filename="gz-sim-air-pressure-system"
      name="gz::sim::systems::AirPressure">
    </plugin>

    <!-- Buoyancy (gz_buoyancy): graded, fresh water (1000 kg/m^3) below z = 0
         and air (1 kg/m^3) above. The interface is the FLAT z = 0 plane, not
         the wave surface: for vehicle physics the waves are visual only.
         Coupling buoyancy to the waves is the job of the future
         gz_waves_buoyancy consumer (WAVES_DESIGN.md §11).

         This world names no vehicle. <enable_by_default> false and no
         <enable> list: the world only describes the fluid, and a link floats
         by the collisions it marks as buoyancy geometry with
         gz:buoyancy="true" (gz-sim commit 229ec07e), whatever name its
         model was spawned under. A vehicle's contact geometry stays contact
         geometry, and a mark needs a zero <collide_bitmask> so the
         displacement volume touches nothing. gz_buoyancy carries that change
         until a Gazebo release with it reaches ROS; then this block switches
         to gz-sim-buoyancy-system / gz::sim::systems::Buoyancy unchanged. -->
    <plugin
      filename="gz-maritime-buoyancy-system"
      name="gz::sim::maritime::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
      <enable_by_default>false</enable_by_default>
    </plugin>

    <!-- Wind (gz_wind). The world owns the wind: <speed> in m/s at 10 m and
         the <direction> it comes from, in degrees clockwise from north (270
         is a wind from the west). Change it while running on the topic
         /world/default/wind/set (keys speed and direction), bridged to ROS
         by the simulation launch. The system keeps the wind as a recipe on
         the world, writes it where Gazebo's rotor, wing and air speed systems
         read it, publishes it on /world/default/wind_info, and pushes on
         the collisions a vehicle marks gz:wind="true", by the part of each
         shape above the water. Like buoyancy, the world names no vehicle.
         Gusts on
         the speed and the direction (<speed_gust>, <direction_gust> and
         their times, <seed>) are listed in the reference docs. -->
    <plugin
      filename="gz-maritime-wind-system"
      name="gz::sim::maritime::Wind">
      <speed>0</speed>
      <direction>0</direction>
      <!-- The speed is at 10 m, as in weather reports; over the sea the wind
           falls off towards the water with this roughness length. -->
      <reference_height>10</reference_height>
      <roughness_length>0.0002</roughness_length>
    </plugin>

    <!-- Ocean current (gz_ocean_current). The world owns the current: <speed>
         in m/s and the <direction> it sets towards, in degrees clockwise from
         north (90 sets east, towards +x; the opposite convention from the
         wind, which is given by where it comes from). Set here, and changed
         while running on the topic /world/default/ocean_current/set (keys
         speed and direction), bridged to ROS by the simulation launch. The
         system keeps it as a recipe on the world, which any system asks at
         a point, and publishes it on /world/default/ocean_current_info.
         Slack by default.
         A rowing lake: slack water, leave it at 0. -->
    <plugin
      filename="gz-maritime-ocean-current-system"
      name="gz::sim::maritime::OceanCurrent">
      <speed>0</speed>
      <direction>0</direction>
    </plugin>

    <!-- ==================================================================
         WAVE SOURCE — the engine is the plugin's identity. Keep exactly ONE of
         the two <plugin> blocks below active and comment the other out. Both
         blocks are deliberately comment-free so either can be wrapped in an XML
         comment cleanly (XML comments cannot nest). Per-parameter notes live in
         the comment directly above each block.
         ================================================================== -->

    <!-- Wave source. Two engines are available: FFT (EncinoWaves spectral,
         higher fidelity) is active here; Gerstner (analytic sum of component
         waves) is the commented alternative below. Full parameter lists and the
         <sea_state> precedence rules live in each plugin's documentation.

         Both blocks set sea state 1 (rippled, Hs 5 cm). Vehicles float on the
         flat z = 0 plane of the buoyancy system above, not on this surface, so
         a rougher sea only shows waves passing through hulls that do not ride
         them. Not 0: a glassy sea mirrors the sky and reads as white. Raise it
         at runtime through /world/default/wave/set_parameters (gz.msgs.Param,
         key sea_state; WAVES_DESIGN.md §8). -->
    <plugin filename="gz-sim-waves-fft-system"
            name="gz::sim::systems::FftWaves">
      <update_rate>30</update_rate>
      <wave>
        <!-- Simplest control: a WMO sea-state code (0-9) sets the whole sea. It
             overrides <period>/<gain> (1 = rippled, 3 = slight, 5 = rough,
             0 = glassy). For a hand-tuned sea, comment <sea_state> and uncomment
             the advanced block (delete the two comment markers wrapping it). -->
        <sea_state>1</sea_state>
        <!-- How far the water is drawn around the water surface model, in
             200 m tiles: 4 is a 1.8 km square. Past it the
             site's far water plane takes over. -->
        <tiles_radius>4</tiles_radius>

        <!-- Advanced / manual setup (a working configuration). <period> sets
             wind speed; <gain> is the amplitude multiplier (9.5 = dramatic and
             intentionally unphysical, ~1.0 = physical Hs); <tile_size> and
             <grid_size> are the periodic domain and FFT resolution; <choppiness>
             sharpens crests; <direction> is parsed but not yet applied
             (EncinoWaves assumes wind along +X). -->
        <!--
        <period>3.2</period>
        <gain>9.5</gain>
        <direction>2.356</direction>
        <tau>2.0</tau>
        <tile_size>256</tile_size>
        <grid_size>128</grid_size>
        <seed>42</seed>
        <choppiness>-2.0</choppiness>
        -->
      </wave>
    </plugin>

    <!-- Gerstner alternative (gz-sim-waves-gerstner-system): analytic sum of
         component waves. To use it instead of FFT, comment the <plugin> above
         and uncomment this one. <sea_state> drives the height; every other
         tag below is the engine default, kept explicit for discoverability.
         Extras like <direction> or <steepness> can be added per the plugin
         docs (they are NOT defaults, so adding them changes the sea). -->
    <!--
    <plugin filename="gz-sim-waves-gerstner-system"
            name="gz::sim::systems::GerstnerWaves">
      <update_rate>30</update_rate>
      <wave>
        <sea_state>1</sea_state>
        <model>PMS</model>
        <number>3</number>
        <angle>0.4</angle>
        <scale>1.1</scale>
        <tau>2.0</tau>
        <grid_size>128</grid_size>
      </wave>
    </plugin>
    -->

    <!-- GUI -->
    <gui fullscreen="0">
      <!-- 3D scene -->
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.6 0.62 0.66</ambient_light>
        <background_color>0.0 0.7 0.8</background_color>
        <!-- Above the finish line by the grandstand, looking east down the 2 km course. -->
        <camera_pose>-760 90 22 0 0.12 -0.05</camera_pose>
        <camera_clip>
          <near>0.1</near>
          <far>50000</far>
        </camera_clip>
      </plugin>

      <!-- Scene management plugins -->
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
        <warn_on_action_failure>false</warn_on_action_failure>
      </plugin>

      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <!-- World control -->
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>

      <!-- World statistics -->
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="ComponentInspector" name="Component Inspector">
        <gz-gui>
          <title>Inspector</title>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>
    </gui>

    <!-- The site, one static model in the world frame: terrain, shore,
         buildings, trees and the sky dome, drawn at the lite tier. Its
         collisions are boxes (the shore, the land near the water, the
         piers and breakwaters and the buildings near the origin), the
         same as the full tier's. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/sydney_regatta_lite</uri>
    </include>

    <!-- The drawn water: one water surface model at the middle of the
         water. Buoyancy does not depend on it: it is the flat z = 0 plane
         everywhere, and the land hides the water under it. -->
    <include>
      <pose>0 0 0 0 0 0</pose>
      <uri>model://water_surface_sydney_regatta</uri>
    </include>

    <!-- The seabed, from bathymetry: optional, for underwater vehicles,
         sonars and DVLs, or a hull grounding on the shallows. -->
    <!--
    <include>
      <uri>https://fuel.gazebosim.org/1.0/honuRobotics/models/sydney_regatta_seabed</uri>
    </include>
    -->

    <!-- A landing pad for aerial vehicles, a static deck 1 m above the
         water just off the start point, where the multi vehicle demo puts
         its X500. Nothing marks its collision, so it does not float; it is
         held up by being static. Spawn a quad on it at z = 1.25. -->
    <include>
      <uri>model://landing_pad</uri>
      <pose>-545 192 0 0 0 0</pose>
    </include>

  </world>
</sdf>
