<?xml version="1.0"?>
<model>
  <name>landing_pad</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>
  <author><name>Honu Robotics</name></author>
  <description>
    A static landing pad above the water: a 4 m square deck on four pylons,
    its top 1 m above the water level. The only solid ground in the open
    water world, for aerial vehicles to stand on.
  </description>
</model>
