<?xml version="1.0"?>
<model>
  <name>sandisland</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>
  <author><name>Open Source Robotics Foundation</name></author>
  <description>
    Sand Island, Honolulu: the RobotX 2018 venue, as modelled for VRX 2019.
