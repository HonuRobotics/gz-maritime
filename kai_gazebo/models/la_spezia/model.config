<?xml version="1.0"?>
<model>
  <name>la_spezia</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>
  <author><name>Open Source Robotics Foundation</name></author>
  <description>
    The marina in the Gulf of La Spezia, Italy: the Virtual Ocean Robotics Challenge (VORC) 2020 venue. The
    mesh and its texture are fetched at build time from the VORC repository
    (Apache 2.0).
  </description>
</model>
