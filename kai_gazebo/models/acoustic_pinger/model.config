<?xml version="1.0"?>
<model>
  <name>acoustic_pinger</name>
  <version>1.0</version>
  <sdf version="1.12">model.sdf</sdf>
  <author><name>Honu Robotics</name></author>
  <description>
    A moored acoustic pinger: a spar buoy on the water with a pinger hanging
    1.5 m under it, 30 kHz once a second with a 300 m reach, as on a
    RoboNation course. Static. The pinger takes the name the model is
    included under; change its settings or the buoy's colour per instance
    with experimental:params. Needs gz-maritime-acoustics-system in the
    world.
  </description>
</model>
