<?xml version="1.0"?>
<!--
  As drawn_surface.sdf, with a colour camera in place of the depth one:
  the test sees the foam the renderer draws from the engine's Foam(). There
  is no wave system here: the test puts its own wave field on the world.
-->
<sdf version="1.9">
  <world name="drawn_foam">
    <physics name="fast" type="dart">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <direction>-0.5 0.3 -0.6</direction>
    </light>
    <include>
      <uri>model://water_surface</uri>
    </include>
    <model name="colour_camera">
      <static>true</static>
      <pose>0 0 60 0 1.5707963267948966 0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>0.8</horizontal_fov>
            <image>
              <width>128</width>
              <height>128</height>
            </image>
            <clip><near>1</near><far>200</far></clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>2</update_rate>
          <topic>drawn_foam/image</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
