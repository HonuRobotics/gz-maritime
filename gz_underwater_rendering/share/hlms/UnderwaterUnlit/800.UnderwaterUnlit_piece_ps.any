// The water between the camera and a fragment that nothing lights (Ogre's
// unlit shaders: particles). Its colour is its own, so no daylight fades it
// and no lamp adds to it; it fades over the range through the water and
// the veil builds up, as for everything else:
//
//   I = C exp(-beta^D w) + B-inf(z_camera) (1 - exp(-beta^B w))
//
// w is the range through the water: up to where a climbing ray leaves it.
// The lamps' beams and marine snow in front of it are not drawn.
// The unlit shaders write a colour as it is, so the listener says whether
// the image is kept in linear light (gz_underwater_linear).
@property( gz_underwater && !hlms_shadowcaster && !gz_render_solid_color && !hlms_identity_viewproj && !hlms_identity_viewproj_dynamic )
// The unlit pixel shader declares the pass buffer only for planar
// reflections and point shadows.
@piece( custom_ps_uniformStructDeclaration_underwater_unlit )
	@property( !has_planar_reflections && !hlms_shadowcaster_point )
		@insertpiece( PassStructDecl )
	@end
@end
@piece( custom_ps_posExecution_underwater_unlit )
	{
		float uwCamDepth = passBuf.uwCamPos_level.w - passBuf.uwCamPos_level.z;
		if( uwCamDepth > 0.0 )
		{
			float3 uwRay = inPs.uwRay;
			float uwRange = length( uwRay );
			float uwW = uwRange;
			if( uwRay.z > 1e-6 * uwRange )
				uwW = min( uwRange, uwCamDepth * uwRange / uwRay.z );
		@property( gz_underwater_linear )
			float3 uwJ = outPs_colour0.xyz;
		@else
			float3 uwJ = outPs_colour0.xyz * outPs_colour0.xyz;
		@end
			float3 uwOut = uwJ * exp( -passBuf.uwAttenuation.xyz * uwW ) +
			               passBuf.uwVeil.xyz *
			               ( float3( 1.0, 1.0, 1.0 ) - exp( -passBuf.uwBackscatter.xyz * uwW ) );
		@property( gz_underwater_linear )
			outPs_colour0.xyz = uwOut;
		@else
			outPs_colour0.xyz = sqrt( uwOut );
		@end
		}
	}
@end
@end
