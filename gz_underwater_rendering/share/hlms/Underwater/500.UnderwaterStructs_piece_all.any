// The water, per pass, appended to the PBS pass buffer by the underwater
// listener (gz_underwater_rendering). All float4, so it stays 16-byte
// aligned whatever comes before it.
@property( gz_underwater )
	@piece( custom_passBuffer_underwater )
		// xyz: the camera's world position; w: the still water level.
		float4 uwCamPos_level;
		// The view-to-world rotation, column by column (xyz).
		float4 uwViewX;
		float4 uwViewY;
		float4 uwViewZ;
		// xyz: beta^D, how fast an object's light fades, 1/m.
		float4 uwAttenuation;
		// xyz: beta^B, how fast the veil builds, 1/m.
		float4 uwBackscatter;
		// xyz: the veil, B-infinity, at the camera's depth.
		float4 uwVeil;
		// xyz: K_d, how fast the daylight fades with depth, 1/m.
		float4 uwDiffuse;
		// xyz: the scattering b, 1/m; w: the phase function's asymmetry g.
		float4 uwScatter;
		// x: lamps; y: beam steps; z: beam range, m; w: beam strength.
		float4 uwLampInfo;
		// x: caustics strength (scaled by the waves); y: marine snow
		// density; w: how far snow is drawn, m.
		float4 uwEffects;
		// The caustics' four phases, each wrapped to [0, 2 pi) on the CPU in
		// double, so the pattern moves on smoothly however long it runs.
		float4 uwCausticPhase;
		// Per lamp, 5 float4 (view space): position, type (1 spot, 0 point);
		// direction, range; diffuse, linear attenuation; spot (1/(cos inner -
		// cos outer), cos outer, falloff), quadratic attenuation; specular.
		float4 uwLamp[20];
	@end
@end
