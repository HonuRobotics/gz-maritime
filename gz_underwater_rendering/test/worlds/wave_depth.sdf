<?xml version="1.0"?>
<!--
  Depth below the waves: two cameras at the same place, one 0.15 m above
  the still water and one 0.15 m below it, look at a white panel 2 m away
  through water that fades light fast (1 /m), under one wave of amplitude
  0.5 m. As the wave passes each is under water for part of the time.
-->
<sdf version="1.9">
  <world name="uwwavedepth">
    <physics name="p" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-waves-gerstner-system" name="gz::sim::systems::GerstnerWaves">
      <update_rate>30</update_rate>
      <wave><model>CWR</model><number>1</number><amplitude>0.5</amplitude><period>4</period><direction>0</direction><steepness>0</steepness><tau>0.5</tau></wave>
    </plugin>
    <plugin filename="gz-maritime-water-optics-system" name="gz::sim::maritime::WaterOptics">
      <attenuation>1 1 1</attenuation><backscatter>0 0 0</backscatter><veil>0 0 0</veil>
      <diffuse_attenuation>0 0 0</diffuse_attenuation><caustics>0</caustics>
    </plugin>
    <scene><ambient>0.8 0.8 0.8 1</ambient><background>0 0 0 1</background></scene>
    <light type="directional" name="sun"><direction>0 1 -0.2</direction><diffuse>0.6 0.6 0.6 1</diffuse><cast_shadows>false</cast_shadows></light>
    <model name="panel"><static>true</static><pose>0 2 0 0 0 0</pose><link name="l"><visual name="v"><geometry><box><size>8 0.02 8</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse><specular>0 0 0 1</specular></material></visual></link></model>
    <model name="rig"><static>true</static>
      <link name="above"><pose>0 0 0.15 0 0 1.5707963</pose><sensor name="cam" type="camera"><topic>uwwavedepth/above</topic><update_rate>10</update_rate><always_on>1</always_on>
        <camera><horizontal_fov>1.0</horizontal_fov><image><width>80</width><height>60</height></image><clip><near>0.1</near><far>60</far></clip></camera></sensor></link>
      <link name="below"><pose>0 0 -0.15 0 0 1.5707963</pose><sensor name="cam" type="camera"><topic>uwwavedepth/below</topic><update_rate>10</update_rate><always_on>1</always_on>
        <camera><horizontal_fov>1.0</horizontal_fov><image><width>80</width><height>60</height></image><clip><near>0.1</near><far>60</far></clip></camera></sensor></link>
    </model>
    <include><uri>model://underwater_optics</uri></include>
  </world>
</sdf>
