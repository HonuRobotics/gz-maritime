<?xml version="1.0"?>
<!--
  A camera 2 m above a rippled sea (sea state 1), looking level at the
  horizon, with the water drawn (a pure green veil, so any of the surface
  shaded as seen from below, faded into it, stands out). All of the surface
  is below the camera: none of it is seen from below, however far away and
  however grazing the view.
-->
<sdf version="1.9">
  <world name="uwhorizon">
    <physics name="p" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-waves-gerstner-system"
            name="gz::sim::systems::GerstnerWaves">
      <update_rate>30</update_rate>
      <wave>
        <sea_state>1</sea_state>
      </wave>
    </plugin>
    <plugin filename="gz-maritime-water-optics-system"
            name="gz::sim::maritime::WaterOptics">
      <attenuation>0.5 0.5 0.5</attenuation>
      <backscatter>0.5 0.5 0.5</backscatter>
      <veil>0 0.6 0</veil>
      <diffuse_attenuation>0.1 0.1 0.1</diffuse_attenuation>
    </plugin>
    <scene><ambient>0.4 0.4 0.4 1</ambient><background>0.7 0.8 0.9 1</background></scene>
    <light type="directional" name="sun"><direction>-0.3 0.2 -1</direction></light>
    <include><uri>model://water_surface</uri></include>
    <include><uri>model://underwater_optics</uri></include>
    <model name="rig">
      <static>true</static>
      <pose>0 0 2 0 0 0</pose>
      <link name="l">
        <sensor name="cam" type="camera">
          <topic>uwhorizon/cam</topic>
          <update_rate>5</update_rate>
          <always_on>1</always_on>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>320</width><height>240</height></image>
            <clip><near>0.1</near><far>2000</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
