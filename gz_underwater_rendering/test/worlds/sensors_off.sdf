<?xml version="1.0"?>
<!--
  Sensors that are not colour cameras, 6 m down in water not drawn by the
  renderer: a lidar, a thermal camera and a bounding box
  camera, looking at a labelled box 5 m ahead and open water around it.
  The same as sensors_on.sdf without the GPU path.
-->
<sdf version="1.9">
  <world name="uwsensors">
    <physics name="p" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-maritime-water-optics-system" name="gz::sim::maritime::WaterOptics">
      <jerlov>3C</jerlov>
    </plugin>
    <scene><ambient>0.4 0.4 0.4 1</ambient><background>0.9 0.9 0.9 1</background></scene>
    <light type="directional" name="sun"><direction>-0.3 0.2 -1</direction></light>
    <model name="target"><static>true</static><pose>5 0 -6 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><box><size>0.5 1 1</size></box></geometry>
        <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>7</label></plugin>
      </visual></link>
    </model>
    <model name="rig"><static>true</static>
      <link name="l"><pose>0 0 -6 0 0 0</pose>
        <sensor name="lidar" type="gpu_lidar"><topic>uwsensors/lidar</topic><update_rate>10</update_rate><always_on>1</always_on>
          <lidar><scan>
            <horizontal><samples>64</samples><resolution>1</resolution><min_angle>-0.7</min_angle><max_angle>0.7</max_angle></horizontal>
            <vertical><samples>8</samples><resolution>1</resolution><min_angle>-0.3</min_angle><max_angle>0.3</max_angle></vertical>
          </scan><range><min>0.1</min><max>50</max><resolution>0.01</resolution></range></lidar>
        </sensor>
        <sensor name="thermal" type="thermal_camera"><topic>uwsensors/thermal</topic><update_rate>10</update_rate><always_on>1</always_on>
          <camera><horizontal_fov>1.2</horizontal_fov><image><width>80</width><height>60</height><format>L16</format></image><clip><near>0.1</near><far>100</far></clip></camera>
        </sensor>
        <sensor name="boxes" type="boundingbox_camera"><topic>uwsensors/boxes</topic><update_rate>10</update_rate><always_on>1</always_on>
          <camera><box_type>2d</box_type><horizontal_fov>1.2</horizontal_fov><image><width>80</width><height>60</height></image><clip><near>0.1</near><far>100</far></clip></camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
