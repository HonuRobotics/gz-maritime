<?xml version="1.0"?>
<!--
  Four lamps, each aimed at its own plate, at <quality>low</quality>, which
  lights two lamps in the shader: the other two are left to Ogre, so all
  four plates are lit.
-->
<sdf version="1.9">
  <world name="uwlamplow">
    <physics name="p" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-maritime-water-optics-system"
            name="gz::sim::maritime::WaterOptics">
      <attenuation>0.05 0.05 0.05</attenuation>
      <backscatter>0.05 0.05 0.05</backscatter>
      <veil>0.1 0.1 0.1</veil>
      <diffuse_attenuation>0.05 0.05 0.05</diffuse_attenuation>
      <daylight>0</daylight>
    </plugin>
    <scene><ambient>0 0 0 1</ambient><background>0 0 0 1</background></scene>
    <light type="spot" name="lamp_0">
      <pose>0 0 -20 0 0 0</pose>
      <direction>3 1.2 0</direction>
      <diffuse>1 1 1 1</diffuse>
      <intensity>10</intensity>
      <specular>0 0 0 1</specular>
      <attenuation><range>40</range><linear>0</linear><quadratic>0.02</quadratic></attenuation>
      <spot><inner_angle>0.1</inner_angle><outer_angle>0.2</outer_angle><falloff>1</falloff></spot>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="spot" name="lamp_1">
      <pose>0 0 -20 0 0 0</pose>
      <direction>3 0.4 0</direction>
      <diffuse>1 1 1 1</diffuse>
      <intensity>10</intensity>
      <specular>0 0 0 1</specular>
      <attenuation><range>40</range><linear>0</linear><quadratic>0.02</quadratic></attenuation>
      <spot><inner_angle>0.1</inner_angle><outer_angle>0.2</outer_angle><falloff>1</falloff></spot>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="spot" name="lamp_2">
      <pose>0 0 -20 0 0 0</pose>
      <direction>3 -0.4 0</direction>
      <diffuse>1 1 1 1</diffuse>
      <intensity>10</intensity>
      <specular>0 0 0 1</specular>
      <attenuation><range>40</range><linear>0</linear><quadratic>0.02</quadratic></attenuation>
      <spot><inner_angle>0.1</inner_angle><outer_angle>0.2</outer_angle><falloff>1</falloff></spot>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="spot" name="lamp_3">
      <pose>0 0 -20 0 0 0</pose>
      <direction>3 -1.2 0</direction>
      <diffuse>1 1 1 1</diffuse>
      <intensity>10</intensity>
      <specular>0 0 0 1</specular>
      <attenuation><range>40</range><linear>0</linear><quadratic>0.02</quadratic></attenuation>
      <spot><inner_angle>0.1</inner_angle><outer_angle>0.2</outer_angle><falloff>1</falloff></spot>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="plate_0">
      <static>true</static>
      <pose>3 1.2 -20 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>0.02 0.6 0.6</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse><specular>0 0 0 1</specular></material>
      </visual></link>
    </model>
    <model name="plate_1">
      <static>true</static>
      <pose>3 0.4 -20 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>0.02 0.6 0.6</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse><specular>0 0 0 1</specular></material>
      </visual></link>
    </model>
    <model name="plate_2">
      <static>true</static>
      <pose>3 -0.4 -20 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>0.02 0.6 0.6</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse><specular>0 0 0 1</specular></material>
      </visual></link>
    </model>
    <model name="plate_3">
      <static>true</static>
      <pose>3 -1.2 -20 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>0.02 0.6 0.6</size></box></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse><specular>0 0 0 1</specular></material>
      </visual></link>
    </model>
    <model name="rig">
      <static>true</static>
      <link name="cam">
        <pose>0 0 -20 0 0 0</pose>
        <sensor name="cam" type="rgbd_camera">
          <topic>uwlamplow/cam</topic>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>160</width><height>120</height></image>
            <clip><near>0.1</near><far>60</far></clip>
            <depth_camera><clip><near>0.1</near><far>60</far></clip></depth_camera>
          </camera>
        </sensor>
      </link>
    </model>
    <model name="underwater_optics">
      <static>true</static>
      <link name="link">
        <visual name="underwater_optics">
          <geometry><box><size>0.001 0.001 0.001</size></box></geometry>
          <transparency>1</transparency>
          <plugin filename="gz-maritime-underwater-rendering-system"
                  name="gz::sim::maritime::UnderwaterRendering">
            <quality>low</quality>
          </plugin>
        </visual>
      </link>
    </model>
  </world>
</sdf>
