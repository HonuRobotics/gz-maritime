<?xml version="1.0"?>
<!--
  With the GPU path: the shader lights with the lamp, hidden from Ogre.
  A camera above the water, 2 m up, and a spot light named "lamp" beside
  it, lighting two plates 3 m ahead: a metal one (left) and a glossy
  painted one (right), and a point lamp above and behind them. Each
  lamp's specular is tinted unlike its diffuse, and the spot's falloff is
  not 1, so the shader must take each as Ogre does. No daylight, no
  ambient: only the lamps light.
-->
<sdf version="1.9">
  <world name="uwair">
    <physics name="p" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-maritime-water-optics-system"
            name="gz::sim::maritime::WaterOptics">
      <jerlov>3C</jerlov>
      <daylight>0</daylight>
    </plugin>
    <scene><ambient>0 0 0 1</ambient><background>0 0 0 1</background></scene>
    <light type="spot" name="lamp">
      <pose>0 0.25 2.1 0 0 0</pose>
      <direction>1 0 0</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>1 0.6 0.3 1</specular>
      <intensity>1</intensity>
      <attenuation><range>20</range><linear>0</linear><quadratic>0.05</quadratic></attenuation>
      <spot><inner_angle>1.0</inner_angle><outer_angle>1.6</outer_angle><falloff>2</falloff></spot>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="lamp_point">
      <pose>1.5 0 3.2 0 0 0</pose>
      <diffuse>0.6 0.8 1 1</diffuse>
      <specular>0.3 1 0.5 1</specular>
      <intensity>0.5</intensity>
      <attenuation><range>10</range><linear>0.1</linear><quadratic>0.1</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="metal">
      <static>true</static>
      <pose>3 0.6 2 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>0.02 1.0 1.4</size></box></geometry>
        <material>
          <diffuse>0.8 0.7 0.6 1</diffuse><specular>1 1 1 1</specular>
          <pbr><metal><metalness>1</metalness><roughness>0.35</roughness></metal></pbr>
        </material>
      </visual></link>
    </model>
    <model name="glossy">
      <static>true</static>
      <pose>3 -0.6 2 0 0 0</pose>
      <link name="l"><visual name="v">
        <geometry><box><size>0.02 1.0 1.4</size></box></geometry>
        <material>
          <diffuse>0.2 0.3 0.5 1</diffuse><specular>1 1 1 1</specular>
          <pbr><metal><metalness>0</metalness><roughness>0.2</roughness></metal></pbr>
        </material>
      </visual></link>
    </model>
    <model name="rig">
      <static>true</static>
      <link name="cam">
        <pose>0 0 2 0 0 0</pose>
        <sensor name="cam" type="rgbd_camera">
          <topic>uwair/cam</topic>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <camera>
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>160</width><height>120</height></image>
            <clip><near>0.1</near><far>60</far></clip>
            <depth_camera><clip><near>0.1</near><far>60</far></clip></depth_camera>
          </camera>
        </sensor>
      </link>
    </model>
    <include>
      <uri>model://underwater_optics</uri>
    </include>
  </world>
</sdf>
