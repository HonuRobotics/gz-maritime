<?xml version="1.0"?>
<!--
  Snell's window: a camera 5 m below near-flat water, looking straight up
  with a 149 degree field of view, sees the sky through a cone of half-angle
  asin(1 / 1.333) = 48.6 degrees, and the water's mirror outside it.
-->
<sdf version="1.9">
  <world name="uwsnell">
    <physics name="p" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-waves-gerstner-system"
            name="gz::sim::systems::GerstnerWaves">
      <update_rate>30</update_rate>
      <wave>
        <model>CWR</model>
        <number>1</number>
        <amplitude>0.001</amplitude>
        <period>4</period>
        <direction>0</direction>
        <steepness>0</steepness>
      </wave>
    </plugin>
    <scene><ambient>0.4 0.4 0.4 1</ambient><background>0.7 0.8 0.9 1</background></scene>
    <light type="directional" name="sun"><direction>-0.3 0.2 -1</direction></light>
    <include><uri>model://water_surface</uri></include>
    <model name="rig">
      <static>true</static>
      <pose>0 0 -5 0 -1.5707963 0</pose>
      <link name="l">
        <sensor name="cam" type="camera">
          <topic>uwsnell/cam</topic>
          <update_rate>5</update_rate>
          <always_on>1</always_on>
          <camera>
            <horizontal_fov>2.6</horizontal_fov>
            <image><width>401</width><height>401</height></image>
            <clip><near>0.1</near><far>500</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
