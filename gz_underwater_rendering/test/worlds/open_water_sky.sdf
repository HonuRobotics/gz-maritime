<?xml version="1.0"?>
<!--
  open_water.sdf with a sky: under the water, open water is still the
  veil, not the sky, which Ogre draws where nothing was drawn yet.
-->
<sdf version="1.9">
  <world name="uwopen">
    <physics name="p" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-waves-gerstner-system" name="gz::sim::systems::GerstnerWaves">
      <update_rate>30</update_rate>
      <wave><model>CWR</model><number>1</number><amplitude>0.05</amplitude><period>4</period><direction>0</direction><steepness>0</steepness></wave>
    </plugin>
    <plugin filename="gz-maritime-water-optics-system" name="gz::sim::maritime::WaterOptics">
      <attenuation>1.2 1.2 1.2</attenuation><backscatter>1.2 1.2 1.2</backscatter><veil>0.1 0.3 0.25</veil>
      <diffuse_attenuation>0.1 0.1 0.1</diffuse_attenuation>
    </plugin>
    <scene><ambient>0.4 0.4 0.4 1</ambient><background>0.9 0.9 0.9 1</background><sky></sky></scene>
    <light type="directional" name="sun"><direction>-0.3 0.2 -1</direction></light>
    <include><uri>model://water_surface</uri></include>
    <include><uri>model://underwater_optics</uri></include>
    <model name="rig"><static>true</static>
      <link name="under"><pose>0 0 -6 0 0 0</pose><sensor name="cam" type="camera"><topic>uwopen/under</topic><update_rate>10</update_rate><always_on>1</always_on>
        <camera><horizontal_fov>1.4</horizontal_fov><image><width>160</width><height>120</height></image><clip><near>0.1</near><far>100</far></clip></camera></sensor></link>
      <link name="rgbd"><pose>0 0 -6 0 0 0</pose><sensor name="rgbd" type="rgbd_camera"><topic>uwopen/rgbd</topic><update_rate>10</update_rate><always_on>1</always_on>
        <camera><horizontal_fov>1.4</horizontal_fov><image><width>160</width><height>120</height></image><clip><near>0.1</near><far>100</far></clip><depth_camera><clip><near>0.1</near><far>100</far></clip></depth_camera></camera></sensor></link>
      <link name="above"><pose>0 0 2 0 0 0</pose><sensor name="cam" type="camera"><topic>uwopen/above</topic><update_rate>10</update_rate><always_on>1</always_on>
        <camera><horizontal_fov>1.4</horizontal_fov><image><width>160</width><height>120</height></image><clip><near>0.1</near><far>100</far></clip></camera></sensor></link>
    </model>
  </world>
</sdf>
