<?xml version="1.0"?>
<!--
  Unlit materials under a wave: as unlit.sdf, but the second camera and its
  particles sit 0.15 m above the still water level, under one wave of
  amplitude 0.5 m (as wave_depth.sdf). The camera is under the wave for part
  of each period, and only then is the water drawn over the particles. The
  first camera stays 5 m up, in air, for the particles' own brightness.
-->
<sdf version="1.9">
  <world name="uwunlitwave">
    <physics name="p" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-waves-gerstner-system" name="gz::sim::systems::GerstnerWaves">
      <update_rate>30</update_rate>
      <wave><model>CWR</model><number>1</number><amplitude>0.5</amplitude><period>4</period><direction>0</direction><steepness>0</steepness><tau>0.5</tau></wave>
    </plugin>
    <plugin filename="gz-maritime-water-optics-system" name="gz::sim::maritime::WaterOptics">
      <attenuation>0.5 0.5 0.5</attenuation><backscatter>0.5 0.5 0.5</backscatter><veil>0.2 0.2 0.2</veil>
      <diffuse_attenuation>0 0 0</diffuse_attenuation><caustics>0</caustics>
    </plugin>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0 0 0 1</background></scene>
    <model name="air"><static>true</static><pose>0 0 5 0 0 0</pose>
      <link name="l">
        <particle_emitter name="wall" type="box"><pose>2 0 0 0 0 0</pose><emitting>true</emitting><size>0.02 0.02 0.02</size><particle_size>1 1 1</particle_size><lifetime>1000</lifetime><rate>20</rate><min_velocity>0</min_velocity><max_velocity>0</max_velocity>
          <material><diffuse>0.5 0.5 0.5 1</diffuse></material></particle_emitter>
        <sensor name="cam" type="camera"><topic>uwunlitwave/air</topic><update_rate>10</update_rate><always_on>1</always_on>
          <camera><horizontal_fov>0.6</horizontal_fov><image><width>80</width><height>60</height></image><clip><near>0.1</near><far>60</far></clip></camera></sensor>
      </link></model>
    <model name="water"><static>true</static><pose>100 0 0.15 0 0 0</pose>
      <link name="l">
        <particle_emitter name="wall" type="box"><pose>2 0 0 0 0 0</pose><emitting>true</emitting><size>0.02 0.02 0.02</size><particle_size>1 1 1</particle_size><lifetime>1000</lifetime><rate>20</rate><min_velocity>0</min_velocity><max_velocity>0</max_velocity>
          <material><diffuse>0.5 0.5 0.5 1</diffuse></material></particle_emitter>
        <sensor name="cam" type="camera"><topic>uwunlitwave/water</topic><update_rate>10</update_rate><always_on>1</always_on>
          <camera><horizontal_fov>0.6</horizontal_fov><image><width>80</width><height>60</height></image><clip><near>0.1</near><far>60</far></clip></camera></sensor>
      </link></model>
    <include><uri>model://underwater_optics</uri></include>
  </world>
</sdf>
